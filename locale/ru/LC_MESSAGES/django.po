msgid "Enter a valid integer."
msgstr "Введите корректное целое число."

#: venv/lib/python3.12/site-packages/django/core/validators.py:211
msgid "Enter a valid email address."
msgstr "Введите корректный адрес электронной почты."

#. Translators: "letters" means latin letters: a-z and A-Z.
#: venv/lib/python3.12/site-packages/django/core/validators.py:289
msgid ""
"Enter a valid “slug” consisting of letters, numbers, underscores or hyphens."
msgstr "Введите корректный «слаг», состоящий из латинских букв, цифр, подчёркиваний или дефисов."

