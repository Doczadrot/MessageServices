"Enter a valid “slug” consisting of Unicode letters, numbers, underscores, or "
"hyphens."
msgstr "Введите корректный «слаг», состоящий из букв Unicode, цифр, подчёркиваний или дефисов."

#: venv/lib/python3.12/site-packages/django/core/validators.py:309
#: venv/lib/python3.12/site-packages/django/core/validators.py:318
#: venv/lib/python3.12/site-packages/django/core/validators.py:332
#: venv/lib/python3.12/site-packages/django/db/models/fields/__init__.py:2220
#, python-format
msgid "Enter a valid %(protocol)s address."
msgstr "Введите корректный адрес %(protocol)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:311
msgid "IPv4"
msgstr "IPv4"

#: venv/lib/python3.12/site-packages/django/core/validators.py:320
#: venv/lib/python3.12/site-packages/django/utils/ipv6.py:43
msgid "IPv6"
msgstr "IPv6"

#: venv/lib/python3.12/site-packages/django/core/validators.py:334
msgid "IPv4 or IPv6"
msgstr "IPv4 или IPv6"

#: venv/lib/python3.12/site-packages/django/core/validators.py:375
msgid "Enter only digits separated by commas."
msgstr "Введите только цифры, разделённые запятыми."

#: venv/lib/python3.12/site-packages/django/core/validators.py:381
#, python-format
msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr "Убедитесь, что значение равно %(limit_value)s (сейчас %(show_value)s)."

#: venv/lib/python3.12/site-packages/django/core/validators.py:416
#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Убедитесь, что значение меньше или равно %(limit_value)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:425
#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Убедитесь, что значение больше или равно %(limit_value)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:434
#, python-format
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Убедитесь, что значение кратно шагу %(limit_value)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:441
#, python-format
msgid ""
"Ensure this value is a multiple of step size %(limit_value)s, starting from "
"%(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr "Убедитесь, что значение кратно шагу %(limit_value)s, начиная с %(offset)s, например, %(offset)s, %(valid_value1)s, %(valid_value2)s и т.д."

#: venv/lib/python3.12/site-packages/django/core/validators.py:473
#, python-format
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at least %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] "Убедитесь, что значение содержит не менее %(limit_value)d символа (сейчас %(show_value)d)."
msgstr[1] "Убедитесь, что значение содержит не менее %(limit_value)d символов (сейчас %(show_value)d)."
msgstr[2] "Убедитесь, что значение содержит не менее %(limit_value)d символов (сейчас %(show_value)d)."
msgstr[3] "Убедитесь, что значение содержит не менее %(limit_value)d символов (сейчас %(show_value)d)."

#: venv/lib/python3.12/site-packages/django/core/validators.py:491
#, python-format
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] "Убедитесь, что значение содержит не более %(limit_value)d символа (сейчас %(show_value)d)."
msgstr[1] "Убедитесь, что значение содержит не более %(limit_value)d символов (сейчас %(show_value)d)."
msgstr[2] "Убедитесь, что значение содержит не более %(limit_value)d символов (сейчас %(show_value)d)."
msgstr[3] "Убедитесь, что значение содержит не более %(limit_value)d символов (сейчас %(show_value)d)."

#: venv/lib/python3.12/site-packages/django/core/validators.py:514
#: venv/lib/python3.12/site-packages/django/forms/fields.py:366
#: venv/lib/python3.12/site-packages/django/forms/fields.py:405
msgid "Enter a number."
msgstr "Введите число."

#: venv/lib/python3.12/site-packages/django/core/validators.py:516
#, python-format
msgid "Ensure that there are no more than %(max)s digit in total."
msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "Убедитесь, что общее количество цифр не превышает %(max)s."
msgstr[1] "Убедитесь, что общее количество цифр не превышает %(max)s."
msgstr[2] "Убедитесь, что общее количество цифр не превышает %(max)s."
msgstr[3] "Убедитесь, что общее количество цифр не превышает %(max)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:521
#, python-format
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "Убедитесь, что количество знаков после запятой не превышает %(max)s."
msgstr[1] "Убедитесь, что количество знаков после запятой не превышает %(max)s."
msgstr[2] "Убедитесь, что количество знаков после запятой не превышает %(max)s."
msgstr[3] "Убедитесь, что количество знаков после запятой не превышает %(max)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:526
#, python-format
msgid ""
"Ensure that there are no more than %(max)s digit before the decimal point."
msgid_plural ""
"Ensure that there are no more than %(max)s digits before the decimal point."
msgstr[0] "Убедитесь, что количество цифр перед запятой не превышает %(max)s."
msgstr[1] "Убедитесь, что количество цифр перед запятой не превышает %(max)s."
msgstr[2] "Убедитесь, что количество цифр перед запятой не превышает %(max)s."
msgstr[3] "Убедитесь, что количество цифр перед запятой не превышает %(max)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:597
#, python-format
msgid ""
"File extension “%(extension)s” is not allowed. Allowed extensions are: "
"%(allowed_extensions)s."
msgstr "Расширение файла «%(extension)s» не разрешено. Разрешённые расширения: %(allowed_extensions)s."

#: venv/lib/python3.12/site-packages/django/core/validators.py:659
msgid "Null characters are not allowed."
msgstr "Нулевые символы не разрешены."

